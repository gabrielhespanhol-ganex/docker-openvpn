# Obrigatorio: revise este dominio em cada nova implantacao.
VPN_ENDPOINT=vpn.ganex.com.br

# Imagem publicada no Docker Hub.
OPENVPN_IMAGE=ganexcloud/openvpn-dco:2.7.5

# Servico OpenVPN.
VPN_PORT=1194
VPN_INTERFACE=ovpn0
VPN_TUN_MTU=1400
MAX_CLIENTS=25

# Rede virtual IPv4. Os tres valores devem representar a mesma rede.
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0
VPN_CIDR=10.8.0.0/24

# DNS entregue aos clientes no full tunnel.
VPN_DNS_1=1.1.1.1
VPN_DNS_2=1.0.0.1

# PKI. SERVER_CN acompanha VPN_ENDPOINT por padrao.
CA_CN=Ganex OpenVPN DCO CA
SERVER_CN=${VPN_ENDPOINT}
CA_CERT_DAYS=7300
SERVER_CERT_DAYS=3650
CLIENT_CERT_DAYS=3650
CRL_DAYS=3650
